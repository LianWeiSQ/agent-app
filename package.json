{
  "name": "openagent-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "check:p0": "node scripts/check-p0.mjs",
    "ci:p0": "node scripts/ci-p0.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:streaming": "node scripts/smoke-real-streaming.mjs",
    "smoke:session-lifecycle": "node scripts/smoke-session-lifecycle-ui.mjs",
    "smoke:sse-stability": "node scripts/smoke-sse-stability-ui.mjs",
    "smoke:provider-recovery": "node scripts/smoke-provider-recovery-ui.mjs",
    "smoke:streaming:sub2api": "node scripts/smoke-real-streaming.mjs --provider=real --model=gpt-5.5",
    "smoke:local-mcp-ui": "node scripts/smoke-local-mcp-ui.mjs",
    "smoke:remote-mcp-oauth": "node scripts/smoke-remote-mcp-oauth-ui.mjs",
    "smoke:plugins": "node scripts/smoke-plugins-ui.mjs",
    "smoke:providers": "node scripts/smoke-provider-catalog-ui.mjs",
    "smoke:git-workflow": "node scripts/smoke-git-workflow-ui.mjs",
    "smoke:capabilities": "node scripts/smoke-capabilities-ui.mjs",
    "smoke:performance": "node scripts/smoke-performance-ui.mjs",
    "smoke:storage-migration": "node scripts/smoke-storage-migration-ui.mjs",
    "smoke:checkpoint-restore-ui": "node scripts/smoke-checkpoint-restore-ui.mjs",
    "smoke:approval-dock": "npm run smoke:approval-dock-ui && npm run smoke:packaged-app:approval-dock",
    "smoke:approval-dock-ui": "node scripts/smoke-approval-dock-ui.mjs",
    "smoke:packaged-app": "node scripts/smoke-packaged-app.mjs",
    "smoke:packaged-app:launchservices": "node scripts/smoke-packaged-app.mjs --launch=launchservices --screenshot=/tmp/openagent-launchservices-smoke.png",
    "smoke:packaged-app:workflow": "node scripts/smoke-packaged-app.mjs --launch=launchservices --workflow=approval-rollback --screenshot=/tmp/openagent-packaged-workflow-smoke.png",
    "smoke:packaged-app:checkpoint-restore": "node scripts/smoke-packaged-app.mjs --launch=launchservices --workflow=approval-rollback --screenshot=/tmp/openagent-packaged-checkpoint-restore-smoke.png",
    "smoke:packaged-app:approval-dock": "node scripts/smoke-packaged-app.mjs --launch=launchservices --workflow=approval-dock --screenshot=/tmp/openagent-packaged-approval-dock-smoke.png",
    "smoke:packaged-app:local-mcp-lifecycle": "node scripts/smoke-packaged-app.mjs --launch=launchservices --workflow=local-mcp-lifecycle --screenshot=/tmp/openagent-packaged-local-mcp-lifecycle-smoke.png",
    "smoke:packaged-app:bridge-recovery": "node scripts/smoke-packaged-app.mjs --launch=launchservices --workflow=bridge-recovery --screenshot=/tmp/openagent-packaged-bridge-recovery-smoke.png",
    "smoke:packaged-app:real-streaming": "node scripts/smoke-packaged-app.mjs --launch=launchservices --workflow=real-streaming --model=gpt-5.5 --screenshot=/tmp/openagent-packaged-real-streaming-smoke.png",
    "tauri": "tauri",
    "core:runtime": "cargo build --manifest-path ../openharness/Cargo.toml -p openagent-http-runtime --release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
